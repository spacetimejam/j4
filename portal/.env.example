# Port the portal listens on
PORT=8710
# Public URL of the portal (used in login links). Must be https unless it is
# localhost: the session cookie is set Secure, and browsers discard Secure
# cookies sent over plain http, which silently breaks login.
BASE_URL=https://portal.example.com
# Secret for signing login cookies; use 64 random hex chars
COOKIE_SECRET=change-me-64-random-hex
# Is the portal reachable from the public internet? private | public | local
# "public" (Tailscale Funnel, or any reverse proxy on a public domain)
# requires a COOKIE_SECRET of at least 64 characters. setup-remote.sh
# configure sets this for you.
# "local" is Jawbs on your own computer: no sign-in, one person, loopback only
# (BIND_HOST=127.0.0.1, BASE_URL=http://localhost:<PORT>). The setup wizard's
# option 1 writes this for you; see docs/portal.md "Using Jawbs on your own computer".
EXPOSURE=private
# Address to bind. setup-remote.sh sets 127.0.0.1 for Tailscale setups; a
# reverse proxy on another host (for example Caddy in Docker) needs 0.0.0.0.
#BIND_HOST=0.0.0.0
# Users live in data/users.json (gitignored), one entry per login email:
#   { "alice@example.com": { "name": "Alice", "projectDir": "/home/alice/job-search-alice", "admin": true } }
# Copy users.example.json to data/users.json and edit it. "admin": true marks
# who receives failure alerts. Legacy single-user installs can instead keep
# using ALLOWED_EMAILS + PROJECT_DIR + USER_NAME below.
#PORTAL_USERS_FILE=data/users.json
#ALLOWED_EMAILS=you@example.com
#PROJECT_DIR=/home/you/job-search
#USER_NAME=Your Name
# SQLite database location (defaults to data/portal.db inside portal/)
#DB_PATH=/home/you/j4/portal/data/portal.db
# Title shown in the web app and email subjects
PORTAL_TITLE=Job Search Portal
# Model for portal agent sessions. Leave unset with AGENT_RUNNER=codex: the
# codex runner then omits --model entirely and lets codex pick its own
# default, rather than passing it a Claude model id. For claude-sdk the
# default is "opus", which always means the newest Opus the installed Agent
# SDK knows (Opus 5.5 at the time of writing). Set a full model id here only
# to pin one.
#AGENT_MODEL=opus
# Agent runner: claude-sdk (default, uses @anthropic-ai/claude-agent-sdk)
#             | codex      (uses `codex exec --json`; run `npm run calibrate` first)
#             | cli        (a CLI that emits one Claude-Code-shaped JSON object)
AGENT_RUNNER=claude-sdk
# Which subscriptions this portal runs on. Opting down to one is deliberate:
#   both          Claude runs the portal and ChatGPT writes the CV and cover
#                 letter copy. Needs Codex installed and signed in
#                 (`codex login`); the portal will not start without Codex.
#   claude-only   Claude writes everything. Codex is never used.
#   chatgpt-only  ChatGPT runs everything. Needs AGENT_RUNNER=codex.
#SUBSCRIPTIONS=both
# Speech to text: a microphone button on the text boxes. The portal turns the
# recording into text itself with an open model; the audio is never stored and
# goes to no outside service. Switch it on with setup/jawbs-speech.sh, which
# downloads the model (about 490 MB) and sets this line. While a recording is
# being transcribed it uses every core and about 1 GB of memory.
#SPEECH_TO_TEXT=on
# Where the model lives. The default is portal/data/speech.
#SPEECH_MODEL_DIR=
# CLI runner command templates (if AGENT_RUNNER=cli). {model} and {sessionId}
# are substituted; the prompt is piped to stdin. Claude Code example:
#AGENT_CMD=claude -p --output-format json --model {model}
#AGENT_CMD_RESUME=claude -p --output-format json --resume {sessionId}
# These templates suit CLIs that print a single JSON object. They do not suit
# codex, which streams newline-delimited events and needs AGENT_RUNNER=codex.
# Gemini CLI and Cursor have no runner; see docs/portal.md.
# Email provider: smtp | brevo | webhook | log (see docs/portal.md)
# "log" sends nothing and prints messages to the terminal, including login
# links. Useful for a first smoke test before you have a mail account.
EMAIL_PROVIDER=smtp
# SMTP connection URL for nodemailer (if EMAIL_PROVIDER=smtp). Username is
# usually your full address with @ written as %40; the password is usually
# an app password, not your normal one. Gmail example:
# smtps://alex%40gmail.com:abcdefghijklmnop@smtp.gmail.com:465
SMTP_URL=
# Sender for outbound mail, e.g. "Job Search Portal <portal@example.com>".
# Left blank deliberately: for SMTP this usually must match the authenticated
# account, and a plausible-looking wrong value is rejected by most providers.
EMAIL_FROM=
# Brevo API key (if EMAIL_PROVIDER=brevo)
#BREVO_API_KEY=
# Generic webhook that receives {to, subject, text, attachments} as JSON (if EMAIL_PROVIDER=webhook)
#WEBHOOK_URL=http://localhost:5678/webhook/portal-email
